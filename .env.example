# ==============================================================================
# ShopMitra Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local to version control.

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings > API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Service role key strictly for server-side actions/admin operations (NEVER expose to client):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Map & Geocoding Provider
# ------------------------------------------------------------------------------
# Supported providers: 'leaflet' (OpenStreetMap - Free) | 'google' | 'mapbox'
NEXT_PUBLIC_MAP_PROVIDER=leaflet
NEXT_PUBLIC_MAP_API_KEY=

# ------------------------------------------------------------------------------
# 3. Application Domain & Telemetry
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ShopMitra

# ------------------------------------------------------------------------------
# 4. Optional Third-Party Communication Integrations
# ------------------------------------------------------------------------------
# SMS OTP Provider (e.g. MSG91 / Fast2SMS / Twilio)
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# Email Provider (e.g. Resend / SendGrid)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=notifications@shopmitra.in
